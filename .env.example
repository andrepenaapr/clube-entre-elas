# Copie este arquivo para ".env" e preencha os valores antes de rodar localmente.

# Chave secreta usada para sessões e proteção CSRF. Use um valor longo e aleatório.
SECRET_KEY=troque-por-um-valor-aleatorio-e-secreto

# Usuário administrador criado automaticamente na primeira execução.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=mudeEstaSenha123

# Opcional: se definido, o sistema usa este banco Postgres em vez do arquivo
# SQLite local. Necessário em hospedagens cujo disco não é persistente
# (ex.: Render sem disco pago). Exemplo (Neon, Supabase, Railway, etc.):
# DATABASE_URL=postgresql://usuario:senha@host/nome_do_banco
